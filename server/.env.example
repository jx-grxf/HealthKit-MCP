# HealthKit MCP server — data source configuration.
#
# With NO Supabase vars set, the server runs in DEMO mode (in-memory synthetic
# data) so you can wire it into Claude Code / Codex immediately. As soon as the
# Supabase vars are present it reads real data, scoped to a single user.

# --- Data source -----------------------------------------------------------
# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key. Server-side only. NEVER ship this in the iOS app.
SUPABASE_SERVICE_ROLE_KEY=

# --- User scoping (dev / stdio) -------------------------------------------
# In stdio/dev mode there is no OAuth, so the server reads data for this user.
# In the remote HTTP build this is replaced by the subject of the OAuth token.
HEALTHKIT_MCP_USER_ID=

# --- Transport -------------------------------------------------------------
# stdio (default, for Claude Code / Codex / local dev) or http (remote).
HEALTHKIT_MCP_TRANSPORT=stdio
