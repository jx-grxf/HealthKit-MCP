# --- Data source ---------------------------------------------------------
# Leave both unset to run against deterministic demo data (no backend needed).
SUPABASE_URL=https://xwmtuzkosztpxjyhvjch.supabase.co
# Server-side only. Bypasses RLS — never ship this in the iOS app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transport -----------------------------------------------------------
# "stdio" (default) for Claude Code / Codex / Claude Desktop, "http" for
# ChatGPT and Claude custom connectors.
HEALTHKIT_MCP_TRANSPORT=stdio

# stdio only: which user's data to serve (no per-request identity exists).
# Ignored under http, where the user is the OAuth token subject.
HEALTHKIT_MCP_USER_ID=

# --- HTTP transport ------------------------------------------------------
PORT=8080
# Canonical public URL of this resource. This is the OAuth audience: tokens are
# bound to it, so it must match the deployment exactly.
MCP_RESOURCE_URL=https://mcp.johannesgrof.me/mcp
MCP_DOCUMENTATION_URL=https://wavelet.johannesgrof.me
# Only set if the authorization server does not mint resource-bound audiences.
# Weakens isolation to "any token from this Supabase project".
# MCP_EXPECTED_AUDIENCE=
